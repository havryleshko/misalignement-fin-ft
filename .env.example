ALPHAVANTAGE_API_KEY=your_alpha_vantage_key_here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/misalignment
REDIS_URL=redis://localhost:6379/0
API_KEY_HASH_SALT=change-me-to-a-long-random-string

LOG_LEVEL=INFO
RATE_LIMIT_RPM=60
CACHE_TTL_SECONDS=300
ENV=local
LLM_PROVIDER=ollama
MODEL_VERSION=llama3-8b-fin-lora-v3
LORA_ENABLED=true
LLM_MODEL=llama3
LLM_BASE_MODEL_ID=meta-llama/Meta-Llama-3-8B-Instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
OLLAMA_HOST=http://localhost:11434
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL_BASE=meta-llama/Meta-Llama-3-8B-Instruct
TOGETHER_MODEL_LORA=llama3-8b-fin-lora-v3
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_BASE=meta-llama/Meta-Llama-3-8B-Instruct
OPENROUTER_MODEL_LORA=llama3-8b-fin-lora-v3